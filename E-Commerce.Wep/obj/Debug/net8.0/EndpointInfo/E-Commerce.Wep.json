                    "type": "number",
                    "format": "double"
                  },
                  "BrandId": {
                    "maximum": 2147483647,
                    "minimum": 1,
                    "type": "integer",
                    "format": "int32"
                  },
                  "TyepId": {
                    "maximum": 2147483647,
                    "minimum": 1,
                    "type": "integer",
                    "format": "int32"
                  }
                }
              },
              "encoding": {
                "Name": {
                  "style": "form"
                },
                "Description": {
                  "style": "form"
                },
                "Images": {
                  "style": "form"
                },
                "PictureUrls": {
                  "style": "form"
                },
                "Price": {
                  "style": "form"
                },
                "BrandId": {
                  "style": "form"
                },
                "TyepId": {
                  "style": "form"
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/ProductDto"
                }
